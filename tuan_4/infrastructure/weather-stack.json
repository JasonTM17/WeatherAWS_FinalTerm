{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "WeatherAWS Week 4 isolated serverless stack with bounded permissions and collection log metrics. Existing LabRole; disabled initial schedule; retained evidence.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "AllowedValues": [
        "son",
        "quyen"
      ],
      "Description": "Isolated environment suffix, not an existing collector name"
    },
    "LabRoleArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:role/LabRole$",
      "Description": "Existing LabRole ARN in this account; no IAM policy changes"
    },
    "ArtifactBucket": {
      "Type": "String",
      "Description": "Existing private versioned artifact bucket in this Region"
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "^artifacts/week4/[a-f0-9]{64}/collector\\.zip$",
      "Description": "Content-addressed collector artifact key"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1,
      "AllowedPattern": "^(?!null$).+$",
      "Description": "Immutable S3 object VersionId; do not use null"
    },
    "AlertEmail": {
      "Type": "String",
      "Default": "",
      "NoEcho": true,
      "AllowedPattern": "^$|^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "Description": "Optional email; subscription requires recipient confirmation"
    }
  },
  "Conditions": {
    "HasEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlertEmail"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "weather-w4-${EnvironmentName}-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "WeatherAWS_FinalTerm"
          },
          {
            "Key": "Stage",
            "Value": "week4"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApiConfig": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Three cities and project alert thresholds; no provider keys",
        "SecretString": "{\"api_provider\":\"open-meteo\",\"aqi_threshold_pm25\":35.5,\"aqi_threshold_pm10\":50,\"aqi_threshold_us_aqi\":100,\"locations\":[{\"city\":\"HoChiMinh\",\"lat\":10.8231,\"lon\":106.6297},{\"city\":\"HaNoi\",\"lat\":21.0285,\"lon\":105.8542},{\"city\":\"DaNang\",\"lat\":16.0544,\"lon\":108.2022}]}",
        "Tags": [
          {
            "Key": "Project",
            "Value": "WeatherAWS_FinalTerm"
          },
          {
            "Key": "Stage",
            "Value": "week4"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "AlertTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": {
          "Fn::Sub": "weather-w4-${EnvironmentName}-alerts"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "WeatherAWS_FinalTerm"
          },
          {
            "Key": "Stage",
            "Value": "week4"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "AlarmTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowOnlyStackAlarm",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "AlertTopic"
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:weather-w4-${EnvironmentName}-errors"
                  }
                },
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "EmailSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasEmail",
      "Properties": {
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        },
        "TopicArn": {
          "Ref": "AlertTopic"
        }
      }
    },
    "CollectorLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/weather-w4-${EnvironmentName}-collector"
        },
        "RetentionInDays": 14
      }
    },
    "Collector": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "CollectorLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "weather-w4-${EnvironmentName}-collector"
        },
        "Runtime": "python3.12",
        "Handler": "lambda_function.lambda_handler",
        "Role": {
          "Ref": "LabRoleArn"
        },
        "Timeout": 60,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "Environment": {
          "Variables": {
            "S3_BUCKET_NAME": {
              "Ref": "DataBucket"
            },
            "SECRET_NAME": {
              "Ref": "ApiConfig"
            },
            "SNS_TOPIC_ARN": {
              "Ref": "AlertTopic"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "WeatherAWS_FinalTerm"
          },
          {
            "Key": "Stage",
            "Value": "week4"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "HourlyRule": {
      "Type": "AWS::Events::Rule",
      "DependsOn": "SchedulePermission",
      "Properties": {
        "Name": {
          "Fn::Sub": "weather-w4-${EnvironmentName}-hourly"
        },
        "ScheduleExpression": "rate(1 hour)",
        "State": "DISABLED",
        "Targets": [
          {
            "Id": "Collector",
            "Arn": {
              "Fn::GetAtt": [
                "Collector",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 300,
              "MaximumRetryAttempts": 1
            }
          }
        ]
      }
    },
    "SchedulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Collector"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:rule/weather-w4-${EnvironmentName}-hourly"
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
    "Database": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Fn::Sub": "weather_w4_${EnvironmentName}"
          },
          "Description": "Week 4 isolated NDJSON catalog"
        }
      }
    },
    "RawTable": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Database"
        },
        "TableInput": {
          "Name": "weather_airquality_records",
          "TableType": "EXTERNAL_TABLE",
          "Parameters": {
            "classification": "json",
            "projection.enabled": "true",
            "projection.year.type": "integer",
            "projection.year.range": "2026,2030",
            "projection.month.type": "integer",
            "projection.month.range": "1,12",
            "projection.month.digits": "2",
            "projection.day.type": "integer",
            "projection.day.range": "1,31",
            "projection.day.digits": "2",
            "storage.location.template": {
              "Fn::Join": [
                "",
                [
                  "s3://",
                  {
                    "Ref": "DataBucket"
                  },
                  "/raw/year=${year}/month=${month}/day=${day}/"
                ]
              ]
            }
          },
          "PartitionKeys": [
            {
              "Name": "year",
              "Type": "string"
            },
            {
              "Name": "month",
              "Type": "string"
            },
            {
              "Name": "day",
              "Type": "string"
            }
          ],
          "StorageDescriptor": {
            "Columns": [
              {
                "Name": "record_id",
                "Type": "string"
              },
              {
                "Name": "city",
                "Type": "string"
              },
              {
                "Name": "latitude",
                "Type": "double"
              },
              {
                "Name": "longitude",
                "Type": "double"
              },
              {
                "Name": "timestamp_utc",
                "Type": "string"
              },
              {
                "Name": "timestamp_vn",
                "Type": "string"
              },
              {
                "Name": "temperature_2m",
                "Type": "double"
              },
              {
                "Name": "relative_humidity_2m",
                "Type": "double"
              },
              {
                "Name": "surface_pressure",
                "Type": "double"
              },
              {
                "Name": "wind_speed_10m",
                "Type": "double"
              },
              {
                "Name": "pm2_5",
                "Type": "double"
              },
              {
                "Name": "pm10",
                "Type": "double"
              },
              {
                "Name": "carbon_monoxide",
                "Type": "double"
              },
              {
                "Name": "nitrogen_dioxide",
                "Type": "double"
              },
              {
                "Name": "sulphur_dioxide",
                "Type": "double"
              },
              {
                "Name": "ozone",
                "Type": "double"
              },
              {
                "Name": "us_aqi",
                "Type": "int"
              },
              {
                "Name": "aqi_category",
                "Type": "string"
              },
              {
                "Name": "hour",
                "Type": "int"
              },
              {
                "Name": "collected_at",
                "Type": "string"
              }
            ],
            "Location": {
              "Fn::Sub": "s3://${DataBucket}/raw/"
            },
            "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
            "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
            "SerdeInfo": {
              "SerializationLibrary": "org.openx.data.jsonserde.JsonSerDe",
              "Parameters": {
                "ignore.malformed.json": "false"
              }
            }
          }
        }
      }
    },
    "QueryWorkgroup": {
      "Type": "AWS::Athena::WorkGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "weather-w4-${EnvironmentName}"
        },
        "State": "ENABLED",
        "RecursiveDeleteOption": false,
        "WorkGroupConfiguration": {
          "EnforceWorkGroupConfiguration": true,
          "PublishCloudWatchMetricsEnabled": true,
          "BytesScannedCutoffPerQuery": 10485760,
          "ResultConfiguration": {
            "OutputLocation": {
              "Fn::Sub": "s3://${DataBucket}/query-results/"
            },
            "EncryptionConfiguration": {
              "EncryptionOption": "SSE_S3"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "WeatherAWS_FinalTerm"
          },
          {
            "Key": "Stage",
            "Value": "week4"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "ErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": "AlarmTopicPolicy",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "weather-w4-${EnvironmentName}-errors"
        },
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Collector"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    },
    "Dashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": {
          "Fn::Sub": "WeatherAirQuality-Week4-${EnvironmentName}"
        },
        "DashboardBody": {
          "Fn::Sub": [
            "{\"widgets\":[{\"type\":\"text\",\"x\":0,\"y\":0,\"width\":24,\"height\":2,\"properties\":{\"markdown\":\"# WeatherAWS Week 4\\n300-second periods. Missing counters are not zero. Email receipt is verified separately.\"}},{\"type\":\"metric\",\"x\":0,\"y\":2,\"width\":12,\"height\":6,\"properties\":{\"region\":\"${AWS::Region}\",\"title\":\"Lambda invocations and errors\",\"period\":300,\"metrics\":[[\"AWS/Lambda\",\"Invocations\",\"FunctionName\",\"${Collector}\",{\"stat\":\"Sum\"}],[\"AWS/Lambda\",\"Errors\",\"FunctionName\",\"${Collector}\",{\"stat\":\"Sum\"}]]}},{\"type\":\"metric\",\"x\":12,\"y\":2,\"width\":12,\"height\":6,\"properties\":{\"region\":\"${AWS::Region}\",\"title\":\"SNS published / delivered / failed\",\"period\":300,\"metrics\":[[\"AWS/SNS\",\"NumberOfMessagesPublished\",\"TopicName\",\"${TopicName}\",{\"stat\":\"Sum\"}],[\"AWS/SNS\",\"NumberOfNotificationsDelivered\",\"TopicName\",\"${TopicName}\",{\"stat\":\"Sum\"}],[\"AWS/SNS\",\"NumberOfNotificationsFailed\",\"TopicName\",\"${TopicName}\",{\"stat\":\"Sum\"}]]}}]}",
            {
              "TopicName": {
                "Fn::GetAtt": [
                  "AlertTopic",
                  "TopicName"
                ]
              }
            }
          ]
        }
      }
    },
    "ResultMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "CollectorLogs"
        },
        "FilterPattern": "\"[INFO] Result:\"",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "WeatherAWS/Week4/${EnvironmentName}"
            },
            "MetricName": "ResultLogLines",
            "MetricValue": "1",
            "Unit": "Count"
          }
        ]
      }
    },
    "ErrorMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "CollectorLogs"
        },
        "FilterPattern": "\"[ERROR]\"",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "WeatherAWS/Week4/${EnvironmentName}"
            },
            "MetricName": "ErrorLogLines",
            "MetricValue": "1",
            "Unit": "Count"
          }
        ]
      }
    }
  },
  "Outputs": {
    "DataBucket": {
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "Collector"
      }
    },
    "RuleName": {
      "Value": {
        "Ref": "HourlyRule"
      }
    },
    "TopicArn": {
      "Value": {
        "Ref": "AlertTopic"
      }
    },
    "SecretArn": {
      "Value": {
        "Ref": "ApiConfig"
      }
    },
    "DatabaseName": {
      "Value": {
        "Ref": "Database"
      }
    },
    "Workgroup": {
      "Value": {
        "Ref": "QueryWorkgroup"
      }
    },
    "DashboardName": {
      "Value": {
        "Ref": "Dashboard"
      }
    }
  }
}
