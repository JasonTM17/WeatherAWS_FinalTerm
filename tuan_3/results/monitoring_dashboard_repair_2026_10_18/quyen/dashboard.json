{
  "start": "-PT24H",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# WeatherAWS Week 3\nSource: tuan_3/scripts/dashboard.py. Metrics share 300s periods. Error rate covers only matched, consistent periods; inspect Counter data gaps before interpreting the window. Missing points are not measured zero. Matching log lines are not invocation counts; delivery counts are not email-read confirmations."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Lambda invocations / errors / throttles",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum"
            }
          ],
          [
            "AWS/Lambda",
            "Errors",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum"
            }
          ],
          [
            "AWS/Lambda",
            "Throttles",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Execution duration (ms)",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/Lambda",
            "Duration",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Average"
            }
          ],
          [
            "AWS/Lambda",
            "Duration",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Maximum"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Error rate (%) - matched periods only",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum",
              "id": "inv",
              "visible": false
            }
          ],
          [
            "AWS/Lambda",
            "Errors",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum",
              "id": "err",
              "visible": false
            }
          ],
          [
            {
              "expression": "IF((inv>0) AND (FILL(err,-1)>=0) AND (err<=inv),100*err/inv)",
              "id": "rate",
              "label": "Errors / Invocations (%) - matched periods only"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 8,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "SNS published / delivered / failed",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/SNS",
            "NumberOfMessagesPublished",
            "TopicName",
            "weather-airquality-alerts",
            {
              "stat": "Sum"
            }
          ],
          [
            "AWS/SNS",
            "NumberOfNotificationsDelivered",
            "TopicName",
            "weather-airquality-alerts",
            {
              "stat": "Sum"
            }
          ],
          [
            "AWS/SNS",
            "NumberOfNotificationsFailed",
            "TopicName",
            "weather-airquality-alerts",
            {
              "stat": "Sum"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 14,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Canonical hourly rule",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/Events",
            "TriggeredRules",
            "RuleName",
            "WeatherCollectionSchedule",
            {
              "stat": "Sum"
            }
          ],
          [
            "AWS/Events",
            "Invocations",
            "RuleName",
            "WeatherCollectionSchedule",
            {
              "stat": "Sum"
            }
          ],
          [
            "AWS/Events",
            "FailedInvocations",
            "RuleName",
            "WeatherCollectionSchedule",
            {
              "stat": "Sum"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 14,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Matching collection log lines (not invocation counts)",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "WeatherAWS/Collection",
            "ResultLogLines",
            {
              "stat": "Sum"
            }
          ],
          [
            "WeatherAWS/Collection",
            "ErrorLogLines",
            {
              "stat": "Sum"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 20,
      "width": 12,
      "height": 6,
      "properties": {
        "region": "us-east-1",
        "title": "Counter data gaps - not a failure rate",
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum",
              "id": "inv",
              "visible": false
            }
          ],
          [
            "AWS/Lambda",
            "Errors",
            "FunctionName",
            "WeatherCollectorLambda",
            {
              "stat": "Sum",
              "id": "err",
              "visible": false
            }
          ],
          [
            {
              "expression": "IF((FILL(inv,-1)<0) AND (FILL(err,-1)>=0),err)",
              "id": "orphan_errors",
              "label": "Errors with no Invocations point"
            }
          ],
          [
            {
              "expression": "IF((inv>0) AND (FILL(err,-1)<0),inv)",
              "id": "missing_errors",
              "label": "Invocations with no Errors point"
            }
          ],
          [
            {
              "expression": "IF((FILL(inv,-1)>=0) AND (err>inv),err)",
              "id": "invalid_counts",
              "label": "Errors exceeding present Invocations"
            }
          ]
        ]
      }
    }
  ]
}
